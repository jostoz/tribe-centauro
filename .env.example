# TRIBE Ads — configuración

# --- Modelo ---
MODEL_NAME=facebook/tribev2
CACHE_DIR=./cache
# auto | cuda | cpu
DEVICE=auto

# --- Licencia ---
# research   -> uso académico/no comercial (CC-BY-NC-4.0)
# commercial -> exige META_LICENSE_REF o el servicio no arranca
LICENSE_MODE=research
META_LICENSE_REF=

# --- Atlas de ROIs ---
ATLAS_DIR=data/atlas/schaefer200

# --- API ---
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# Lista separada por comas. Nunca "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=

# --- HuggingFace (Llama-3.2 es gated; requerido para entrada de texto) ---
HF_TOKEN=
